# Fetch the download base url from the OBS api at startup and use it as
# the prefix stripped from repo urls when deriving the OBS path
# project/repository. Only needed for the analysing http server.
eval {
  my $body = BSRPC::rpc({ 'uri' => "$obsurl/configuration",
                          'request' => 'GET',
                          'headers' => [$header],
                          'timeout' => 30 }, undef);
  my ($download_url) = ($body =~ m{<download_url>\s*([^<]+?)\s*</download_url>});
  $BSPreset::gitprefix = BSPreset::normalize_gitprefix($download_url) if defined $download_url && length $download_url;
  print "using download_url $BSPreset::gitprefix\n";
} unless @ARGV;
print "failed to read download_url from $obsurl/configuration: $@\n" if $@;

sub repositoryresults {
  my ($cgi) = @_;

  my $scmrepo = $cgi->{'scmrepository'};
  my $scmbranch = $cgi->{'scmbranch'};

  my $query = {'scmrepository' => $scmrepo,
	       'scmbranch'     => $scmbranch };
  my @args = BSRPC::args($query, 'scmrepository', 'scmbranch');
  my $r = BSRPC::rpc({'uri' => "$obsurl/build/_result",
	              'request' => 'GET',
	              'headers' => [$header]},
                      $BSXML::resultlist,
                     @args);

  my $html = '<table> <tr> <th>Project</th><th>Package</th> <th>Repository</th> <th>Architecture</th> <th>Result</th> </tr>';
  my $lastproject = '';
  my $lastpackage = '';
  my $lastrepo = '';
  my $count = 0;
  for my $result (@{$r->{'result'} || []}) {
    my $project = $result->{'project'};
    my $package = $result->{'status'}[0]->{'package'} || undef;
    my $repo    = $result->{'repository'};
    my $arch    = $result->{'arch'};
    my $code    = $result->{'status'}[0]->{'code'} || 'unknown';

    $project = '' if $project eq $lastproject;
    $package = '' if $package eq $lastpackage;
    $repo = ''    if $repo eq $lastrepo;
    $count = $count + 1;

    my $bgcolor = "#fff";
    $bgcolor = "#bbb" if $code eq 'scheduled' || $code eq 'building' ||  $code eq 'finished' || $code eq 'blocked';
    my $color = "#FFF";
    $color = "#6EB927" if $code eq 'succeeded';
    $color = "#666" if $code eq 'signing';
    $color = "#222" if $code eq 'finished';
    $color = "#c00" if $code eq 'unresolvable';
    $color = "#e00" if $code eq 'broken';
    $color = "#f00" if $code eq 'failed';
    $color = "#fff" if $code eq 'blocked';

    $html .= "<tr><td>$project</td><td>$package</td> <td>$repo</td> <td>$arch</td> <td bgcolor=\"$bgcolor\"><font color=\"$color\">$code</font></td> </tr>\n";

    $lastproject = $project unless $project eq '' ;
    $lastpackage = $package unless $package eq '' ;
    $lastrepo    = $repo    unless $repo eq '';
    last if $count > 10;
  };
  $html .= '</table>';
  $html .= '<p>.... uncollapsing not implemeted...</p>' if $count > 10;
  return $html;
}

sub gitref_to_branch {
  my ($ref) = @_;
  return undef unless defined $ref;
  $ref =~ s/^refs\/heads\///;
  $ref =~ s/^refs\/tags\///;
  $ref =~ s/^refs\///;
  return $ref;
}

# In the fork case, determine the set of package source directories whose
# latest content differs from the repository this git repo was forked from.
# Package source directories are derived from the _manifest subdirectories
# array (or the top level when absent). Returns a sorted arrayref of changed
# package source directories, or undef when the batch is not a fork or the
# manifest cannot be parsed.
sub fork_changed_package_sources {
  my ($manifest, $batch) = @_;
  my $repository = ref($batch) eq 'HASH' ? $batch->{'repository'} : undef;
  my $parent = ref($repository) eq 'HASH' ? $repository->{'parent'} : undef;
  return undef unless ref($parent) eq 'HASH' && $parent->{'full_name'} && $repository->{'full_name'};
  my $branch = gitref_to_branch($batch->{'ref'});
  return undef unless defined $branch;
  # The branch of the forked-from repository may differ from the fork branch,
  # e.g. when the fork lives on a differently named branch. Gitea events do not
  # carry it, so the fork branch is used unless the synthetic --parent batch
  # specifies one.
  my $parent_branch = parent_branch_of($batch);
  $parent_branch = $branch unless defined $parent_branch;
  my $gitdir = "$gitea_root/gitea-repositories/" . lc($repository->{'full_name'}) . ".git";
  my $parent_gitdir = "$gitea_root/gitea-repositories/" . lc($parent->{'full_name'}) . ".git";
  my $subdirectories = eval { BSPreset::manifest_subdirectories($manifest) };
  return undef if $@;
  my %entries;
  if (ref($subdirectories) eq 'ARRAY' && @$subdirectories) {
    for my $sub (@$subdirectories) {
      $entries{$sub} = git_lstree_sources($gitdir, "$branch:$sub");
    }
  } else {
    $entries{''} = git_lstree_sources($gitdir, $branch);
  }
  my $dirs = BSPreset::package_source_dirs($subdirectories, %entries);
  my %hashes;
  my %parent_hashes;
  for my $dir (@$dirs) {
    my $out = git_capture('--git-dir=' . $gitdir, 'rev-parse', "$branch:$dir");
    $hashes{$dir} = $out->[0] if $out && defined $out->[0];
    my $pout = git_capture('--git-dir=' . $parent_gitdir, 'rev-parse', "$parent_branch:$dir");
    $parent_hashes{$dir} = $pout->[0] if $pout && defined $pout->[0];
  }
  return [ sort @{ BSPreset::changed_package_sources($dirs, \%hashes, \%parent_hashes) } ];
}

# Return the branch of the forked-from repository from a fork batch, or undef
# when the batch does not specify one. Gitea webhook batches carry no parent
# branch, only the synthetic --parent batch constructed for the single-shot
# commands does.
sub parent_branch_of {
  my ($batch) = @_;
  my $repository = ref($batch) eq 'HASH' ? $batch->{'repository'} : undef;
  my $parent = ref($repository) eq 'HASH' ? $repository->{'parent'} : undef;
  return undef unless ref($parent) eq 'HASH';
  my $branch = $parent->{'branch'};
  return undef unless defined $branch && length $branch;
  return gitref_to_branch($branch);
}

# Build the clone url of the repository $org/$name on the same Gitea instance
# as the given reference clone url.
sub clone_url_for_repo {
  my ($clone_url, $org, $name) = @_;
  my $url = BSPreset::scmsync_url_for($clone_url, $org, $name, '_');
  $url =~ s/\#_$// if defined $url;
  return $url;
}

# Scan the organisation of an event for _manifest files declaring a
# package_set for it and refresh the corresponding organisation projects, so
# pushes to any member repository keep the package list of the org project
# up to date. The manifest may live in any repository of the organisation, it
# is looked up on the branch of the event.
sub process_org_package_sets {
  my ($fullname, $branch, $clone_url) = @_;
  return unless defined $autosetup_prefix && defined $gitea_root;
  return unless defined $fullname && $fullname =~ m{^([^/]+)/} && defined $branch && length $branch;
  return unless defined $clone_url && length $clone_url;
  my $org = $1;
  my $orgdir = "$gitea_root/gitea-repositories/" . lc($org);
  my $names = BSGit::org_repo_names($gitea_root, $org);
  if (!@$names) {
    my $aerr = BSGit::dir_access_error($orgdir);
    print "org package_set: $aerr" if $aerr;
    return;
  }
  for my $name (@$names) {
    my $gitdir = "$orgdir/$name.git";
    my $manifest = git_show($gitdir, $branch, '_manifest');
    if (!defined $manifest) {
      my $aerr = BSGit::repo_access_error($gitdir);
      print "org package_set: $aerr" if $aerr;
      next;
    }
    my $set = eval { BSPreset::manifest_package_set($manifest) };
    next if $@ || ref($set) ne 'HASH';
    my $manifest_clone = clone_url_for_repo($clone_url, $org, $name);
    my $resolved = eval { BSPreset::resolve_package_set($set, $manifest_clone) };
    print "org package_set in $org/$name: $@" if $@;
    next if $@ || !defined $resolved;
    next unless $resolved->{'organisation'} eq $org;
    # only sets covering the branch of this event concern us here
    next unless $resolved->{'branch'} eq $branch || $resolved->{'branch'} eq 'default';
    my $projectname = BSPreset::branch_project_name($autosetup_prefix, $org, $name, $branch);
    eval {
      setup_package_set_project($projectname, BSPreset::manifest_presets($manifest), undef, "$manifest_clone#$branch", $set);
    };
    print "org package_set: failed to refresh $projectname: $@\n" if $@;
  }
}

# Return the pending event files in the queue directory in processing order.
sub queue_files {
  return () unless -d $queue_dir;
  opendir(my $dir_handle, $queue_dir) or return ();
  my @files = sort grep { /^\d+(?:-\d+)*\.json$/ } readdir($dir_handle);
  closedir($dir_handle);
  return @files;
}

# Work off the event queue. The queue directory is shared by all the preforked
# server children, so it is processed under an exclusive lock taken in a
# non-blocking way: a child that does not get the lock hands its event over to
# the working process and returns. That process re-checks the queue until it
# stays empty while holding the lock, so handed over events are picked up
# there before the lock goes away. A failed event aborts the run and stays in
# the queue for a retry by a later event delivery or a service restart.
sub process_queue {
  return unless -d $queue_dir;
  my $lockpath = "$queue_dir/.queue.lock";
  while (1) {
    my @files = queue_files();
    last unless @files;
    open(my $lock_fh, '>>', $lockpath) or last;
    unless (flock($lock_fh, LOCK_EX | LOCK_NB)) {
      close($lock_fh);
      print "Queue: another process is working the queue, the pending events are picked up there\n";
      last;
    }
    # the queue may have changed since the first look
    @files = queue_files();
    for my $file (@files) {
      my $filepath = "$queue_dir/$file";
      my $content = do { local $/; open(my $fh, '<', $filepath) or next; binmode($fh); <$fh> };
      my $batch = eval { JSON::XS::decode_json($content) };
      if (!defined $batch) {
        # a broken event would block the queue forever, park it aside
        print "Queue: dropping undecodable event in $file: $@";
        rename($filepath, "$filepath.bad") or unlink($filepath);
        next;
      }
      my $kind = BSPreset::gitea_event_kind($batch);
      my $repository = ref($batch) eq 'HASH' ? $batch->{'repository'} : undef;
      my $fullname = ref($repository) eq 'HASH' ? $repository->{'full_name'} : undef;
      my $clone_url = ref($repository) eq 'HASH' ? $repository->{'clone_url'} : undef;

      my $ok = 1;
      if (!defined($kind)) {
        print "Queue: ignoring unsupported event in $file\n";
      } elsif ($kind eq 'branch_delete') {
        $ok = handle_branch_delete($fullname, $clone_url, gitref_to_branch($batch->{'ref'}));
      } elsif ($kind eq 'repo_delete') {
        $ok = handle_repo_delete($fullname, $clone_url);
      } elsif ($kind eq 'push') {
        $ok = handle_push($batch, $fullname, $clone_url);
      } else {
        # tag deletions and other repository events do not affect our projects
        print "Queue: ignoring $kind event in $file\n";
      }
      unless ($ok) {
        print "Queue: failed to process $file, keeping it for a later retry\n";
        close($lock_fh);
        return;
      }
      unlink($filepath) or print "Queue: failed to delete $filepath: $!\n";
      print "Processed: $kind event for " . (defined($clone_url) ? $clone_url : $fullname) . " from $file\n";
    }
    close($lock_fh);
    # events written while we were working are processed in the next round
  }
}

# Handle a push event: create or update the OBS project of the pushed branch
# from its _manifest, refresh the organisation wide package sets this
# repository may be part of and trigger the scmsync update in OBS. Returns
# false when the event could not be processed and should be retried later.
sub handle_push {
  my ($batch, $fullname, $clone_url) = @_;
  return 1 unless defined($clone_url) && length($clone_url);
  my $branch = gitref_to_branch($batch->{'ref'});
  my $own_set;
  if ($fullname && defined $autosetup_prefix) {
    my $gitdir = "$gitea_root/gitea-repositories/" . lc($fullname) . ".git";
    my $manifest = git_show($gitdir, $branch, '_manifest');
    if (!defined $manifest) {
      my $aerr = BSGit::repo_access_error($gitdir);
      print "Queue: $aerr" if $aerr;
    }
    if (defined $manifest) {
      $own_set = eval { BSPreset::manifest_package_set($manifest) };
      print "Queue: invalid package_set in $fullname#$branch: $@\n" if $@;
      my ($org, $repo) = split('/', $fullname, 2);
      if (!defined $org || !defined $repo) {
        print "setup_project: cannot determine org/repo from $fullname\n";
      } else {
        my $scmsync = "$clone_url#$branch";
        eval {
          setup_project($manifest, BSPreset::branch_project_name($autosetup_prefix, $org, $repo, $branch), $batch, $scmsync);
        };
        print "setup_project: failed: $@" if $@;
      }
    }
  }

  # pushes to the other repositories of an organisation wide package_set
  # refresh the package list of the organisation project as well
  process_org_package_sets($fullname, $branch, $clone_url) unless defined $own_set;

  my $cgi = { 'cmd'           => 'triggerscmsync',
		'scmrepository' => $clone_url,
		'scmbranch'     => $branch };
  $cgi->{'isdefaultbranch'} = 1 if $batch->{'repository'}->{'default_branch'} eq $branch;
  my @args = BSRPC::args($cgi, 'cmd', 'scmrepository', 'scmbranch', 'isdefaultbranch');

  eval {
    my $h = BSRPC::rpc({ 'uri' => "$obsurl/source",
    		  	   'request' => 'POST',
    		  	   'headers' => [$header],
    		  	   'timeout' => 30 }, undef, @args);
  };
  if ($@) {
    print "Queue: failed to trigger the scmsync update for $clone_url#$branch: $@\n";
    return 0;
  }
  return 1;
}

# A branch of $fullname was deleted on the gitea side: delete the OBS project
# created for that branch and remove the packages synchronised from it out of
# the organisation wide package set projects.
sub handle_branch_delete {
  my ($fullname, $clone_url, $branch) = @_;
  return 1 unless defined $autosetup_prefix;
  my ($org, $repo) = split('/', $fullname // '', 2);
  if (!defined($org) || !length($org) || !defined($repo) || !length($repo) || !defined($branch) || !length($branch)) {
    print "branch_delete: cannot determine org, repo or branch of $fullname#$branch\n";
    return 1;
  }
  print "branch_delete: $org/$repo#$branch was deleted\n";
  my $failed;
  my $projectname = BSPreset::branch_project_name($autosetup_prefix, $org, $repo, $branch);
  my (undef, $err) = get_project_meta($projectname);
  if ($err) {
    if ($err =~ /^404/) {
      print "branch_delete: project $projectname does not exist in OBS\n";
    } else {
      # anything but a missing project deserves a retry
      print "branch_delete: cannot read the project meta of $projectname: $err";
      return 0;
    }
  } else {
    delete_project($projectname) or $failed = 1;
  }
  purge_org_packages($org, $repo, $branch, $clone_url) or $failed = 1;
  return !$failed;
}

# The repository $fullname was deleted on the gitea side: delete all OBS
# projects created for its branches and remove its packages out of the
# organisation wide package set projects.
sub handle_repo_delete {
  my ($fullname, $clone_url) = @_;
  return 1 unless defined $autosetup_prefix;
  my ($org, $repo) = split('/', $fullname // '', 2);
  if (!defined($org) || !length($org) || !defined($repo) || !length($repo)) {
    print "repo_delete: cannot determine org and repo of $fullname\n";
    return 1;
  }
  print "repo_delete: $org/$repo was deleted\n";
  my $failed;
  my ($projects, $err) = search_projects(BSPreset::repo_project_prefix($autosetup_prefix, $org, $repo));
  if (!defined $projects) {
    print "repo_delete: cannot list the OBS projects of $org/$repo: $err\n";
    return 0;
  }
  delete_project($_) or $failed = 1 for @$projects;
  purge_org_packages($org, $repo, undef, $clone_url) or $failed = 1;
  return !$failed;
}

# Remove the packages synchronised from $org/$repo, restricted to $branch when
# one is given, out of the OBS projects of the rest of the organisation. This
# keeps organisation wide package set projects in shape when a member
# repository or one of its branches is gone. $clone_url is any clone url on
# the gitea instance, it restricts the removal to repositories of that
# instance.
sub purge_org_packages {
  my ($org, $repo, $branch, $clone_url) = @_;
  return 1 unless defined $autosetup_prefix;
  my $host = BSPreset::git_host($clone_url);
  if (!defined $host) {
    print "purge: cannot determine the gitea host of $clone_url, keeping the organisation projects\n";
    return 1;
  }
  (my $org2 = $org) =~ s/:/_/g;
  my ($projects, $err) = search_projects("$autosetup_prefix:$org2:");
  if (!defined $projects) {
    print "purge: cannot list the OBS projects of $org: $err\n";
    return 0;
  }
  # projects of the deleted repository itself get handled as a whole
  my $own_prefix = BSPreset::repo_project_prefix($autosetup_prefix, $org, $repo);
  my $failed;
  for my $projectname (grep { index($_, $own_prefix) != 0 } @$projects) {
    my ($names, $err) = get_project_packages($projectname);
    if (!defined $names) {
      print "purge: cannot list packages of $projectname: $err\n";
      $failed = 1;
      next;
    }
    for my $packagename (@$names) {
      my ($meta, $err) = get_package_meta($projectname, $packagename);
      next if $err;
      my $scmsync = ref($meta) eq 'HASH' ? $meta->{'scmsync'} : undef;
      next unless BSPreset::scmsync_from_source($scmsync, $host, $org, $repo, $branch);
      print "purge: deleting package $projectname/$packagename\n";
      delete_package($projectname, $packagename) or $failed = 1;
    }
  }
  return !$failed;
}

sub setup_project {
  my ($manifest, $projectname, $batch, $scmsync) = @_;
  my $presets = eval { BSPreset::manifest_presets($manifest) };
  if ($@) {
    print "setup_project: $@";
    return;
  }
  my $set = eval { BSPreset::manifest_package_set($manifest) };
  if ($@) {
    print "setup_project: $@";
    return;
  }
  if ($set) {
    setup_package_set_project($projectname, $presets, $batch, $scmsync, $set);
  } elsif ($presets && @$presets) {
    create_or_update_project($projectname, $presets, $batch, $scmsync, $manifest);
  } else {
    delete_project($projectname);
  }
}

# Set up a project whose packages come from all repositories of a Gitea
# organisation (the package_set case): the project meta is built from the
# presets without a project level scmsync, one git backed package with a
# package level scmsync is created per member repository. Fork handling does
# not apply here, the packages of the organisation keep their own projects.
sub setup_package_set_project {
  my ($projectname, $presets, $batch, $scmsync, $set) = @_;
  unless ($presets && @$presets) {
    print "setup_project: package_set without presets, cannot set up $projectname\n";
    return;
  }
  my $clone_url = (ref($batch) eq 'HASH' && ref($batch->{'repository'}) eq 'HASH' && $batch->{'repository'}->{'clone_url'}) || $scmsync;
  $clone_url =~ s/\#.*$// if defined $clone_url;
  my $resolved = eval { BSPreset::resolve_package_set($set, $clone_url) };
  if ($@) {
    print "setup_project: $@";
    return;
  }
  # an organisation store we cannot read would look like an empty
  # organisation and wipe the package list, keep it untouched instead
  my $orgdir = "$gitea_root/gitea-repositories/" . lc($resolved->{'organisation'});
  my $aerr = BSGit::dir_access_error($orgdir);
  if ($aerr) {
    print "setup_project: $aerr, keeping packages of $projectname untouched\n";
    return;
  }
  # the batch stays undef: fork handling does not apply to organisation sets
  unless (create_or_update_project($projectname, $presets, undef, undef, undef)) {
    print "setup_project: skipping package reconciliation for $projectname, the project meta was not updated\n";
    return;
  }
  my $members = BSGit::org_repo_members($gitea_root, $resolved->{'organisation'}, $resolved->{'branch'});
  $members = BSPreset::select_members($members, $resolved);
  print "setup_project: organisation $resolved->{'organisation'} has " . (0 + @$members) . " package_set members for $projectname\n";
  reconcile_package_set($projectname, $resolved, $members, $clone_url);
}

# True when $projectname is a project this bridge manages: below the
# configured autosetup prefix and made only of characters which are safe
# inside the path of an api url and accepted by OBS. Project names are
# derived from repository events, never act on a name failing this check.
sub project_in_scope {
  my ($projectname) = @_;
  return BSPreset::project_name_in_scope($autosetup_prefix, $projectname);
}

# Delete a project with all its packages from OBS. Deleting the project meta
# alone would leave the packages behind, a delete on the project source purges
# the whole project. The delete is forced, OBS otherwise refuses to remove a
# project while repositories path-depend on it, e.g. through self referencing
# path entries. The delete is a cleanup: a project which does not exist is no
# error. Logs exactly one line about the outcome.
sub delete_project {
  my ($projectname) = @_;
  unless (project_in_scope($projectname)) {
    print "delete_project: refusing to delete $projectname, not a project below the $autosetup_prefix prefix\n";
    return 0;
  }
  my @hdrs = defined $api_auth ? ($api_auth) : ();
  eval {
    BSRPC::rpc({ 'uri' => "$source_url/source/$projectname",
    		  	   'request' => 'DELETE',
    		  	   'headers' => \@hdrs,
    		  	   'timeout' => 30 }, undef, BSRPC::args({'force' => '1'}, 'force'));
  };
  # the delete is only a cleanup, a project which is gone already is fine
  if (!$@) {
    print "delete_project: cleanup deleted project $projectname\n";
  } elsif ($@ =~ /^404/) {
    print "delete_project: cleanup found no project $projectname, nothing to delete\n";
  } else {
    print "delete_project: cleanup failed to delete $projectname: $@";
    return 0;
  }
  return 1;
}

# Remove a package with all its content from OBS.
sub delete_package {
  my ($projectname, $packagename) = @_;
  unless (project_in_scope($projectname) && package_name_in_scope($packagename)) {
    print "delete_package: refusing to delete $projectname/$packagename, not a project below the $autosetup_prefix prefix or an unsafe name\n";
    return 0;
  }
  my @hdrs = defined $api_auth ? ($api_auth) : ();
  eval {
    BSRPC::rpc({ 'uri' => "$source_url/source/$projectname/$packagename",
    		  	   'request' => 'DELETE',
    		  	   'headers' => \@hdrs,
    		  	   'timeout' => 30 }, undef);
  };
  if ($@) {
    return 1 if $@ =~ /^404/;  # the package is gone already
    print "delete_package: failed to delete $projectname/$packagename: $@\n";
    return 0;
  }
  return 1;
}

# List the names of all OBS projects whose name starts with $prefix, using the
# project search with an attribute prefix match. Returns an arrayref of names
# or (undef, error).
sub search_projects {
  my ($prefix) = @_;
  my $match = "starts-with(\@name,'$prefix')";
  $match =~ s/([^A-Za-z0-9_.~-])/sprintf('%%%02X', ord($1))/ge;
  my @hdrs = defined $api_auth ? ($api_auth) : ();
  my $body;
  eval {
    $body = BSRPC::rpc({ 'uri' => "$source_url/search/project?match=$match",
    		  	   'request' => 'GET',
    		  	   'headers' => \@hdrs,
    		  	   'verbatim_uri' => 1,
    		  	   'timeout' => 30 }, undef);
  };
  return (undef, $@) if $@;
  my @names;
  while (($body || '') =~ m{<project\b[^>]*\bname="([^"]*)"}g) {
    my $name = $1;
    $name =~ s/&lt;/</g;
    $name =~ s/&gt;/>/g;
    $name =~ s/&quot;/"/g;
    $name =~ s/&#39;/'/g;
    $name =~ s/&#(\d+);/chr($1)/ge;
    $name =~ s/&#x([0-9a-fA-F]+);/chr(hex($1))/ge;
    $name =~ s/&amp;/&/g;
    # only touch projects which really are ours, whatever the search returns
    push @names, $name if index($name, $prefix) == 0;
  }
  return (\@names, undef);
}

# Build the project meta xml for $projectname. In the fork case, add upstream
# path entries for each preset repository and restrict the build to the package
# sources that actually changed against the forked-from repository, by adding
# an onlybuild CGI parameter per changed package to the scmsync url.
# Dies when the project xml cannot be built.
sub project_xml {
  my ($projectname, $presets, $batch, $scmsync, $manifest) = @_;

  my $extrapaths = parent_project_paths($projectname, $presets, $batch);
  my $changed = fork_changed_package_sources($manifest, $batch);
  if ($changed && @$changed) {
    $scmsync = BSPreset::scmsync_with_onlybuild($scmsync, $changed);
    print "project_xml: building $projectname only for changed packages: @$changed\n";
  }
  my $xml = eval { BSPreset::preset_xml($projectname, $presets, $extrapaths, $scmsync) };
  die("cannot build project xml for $projectname: $@\n") if $@;
  return $xml;
}

sub create_or_update_project {
  my ($projectname, $presets, $batch, $scmsync, $manifest) = @_;

  unless (project_in_scope($projectname)) {
    print "create_or_update_project: refusing to touch $projectname, not a project below the $autosetup_prefix prefix\n";
    return 0;
  }

  my $xml = eval { project_xml($projectname, $presets, $batch, $scmsync, $manifest) };
  if ($@) {
    print "create_or_update_project: $@";
    return 0;
  }
  print "create_or_update_project: project xml for $projectname:\n$xml";

  my @hdrs = ('Content-Type: text/xml');
  push @hdrs, $api_auth if defined $api_auth;
  eval {
    BSRPC::rpc({ 'uri' => "$source_url/source/$projectname/_meta",
    		  	   'request' => 'PUT',
    		  	   'headers' => \@hdrs,
    		  	   'timeout' => 30,
    		  	   'data' => $xml }, undef);
  };
  if ($@) {
    print "create_or_update_project: failed to update $projectname: $@\n";
    return 0;
  }
  return 1;
}

# Read the project meta of $projectname from the OBS api.
sub get_project_meta {
  my ($projectname) = @_;
  return (undef, "refused: $projectname is not a project below the $autosetup_prefix prefix\n") unless project_in_scope($projectname);
  my @hdrs = defined $api_auth ? ($api_auth) : ();
  my $meta;
  eval {
    $meta = BSRPC::rpc({ 'uri' => "$source_url/source/$projectname/_meta",
    		  	   'request' => 'GET',
    		  	   'headers' => \@hdrs,
    		  	   'timeout' => 30 },
    		  	   $BSXML::proj);
  };
  return ($meta, $@);
}

# Read the package meta of $packagename in $projectname from the OBS api.
sub get_package_meta {
  my ($projectname, $packagename) = @_;
  return (undef, "refused: $projectname/$packagename is not a project below the $autosetup_prefix prefix\n") unless project_in_scope($projectname) && package_name_in_scope($packagename);
  my @hdrs = defined $api_auth ? ($api_auth) : ();
  my $meta;
  eval {
    $meta = BSRPC::rpc({ 'uri' => "$source_url/source/$projectname/$packagename/_meta",
    		  	   'request' => 'GET',
    		  	   'headers' => \@hdrs,
    		  	   'timeout' => 30 },
    		  	   $BSXML::pack);
  };
  return ($meta, $@);
}

# List the package names of $projectname from the OBS api. Meta entries
# starting with an underscore are not packages and get left out.
sub get_project_packages {
  my ($projectname) = @_;
  return (undef, "refused: $projectname is not a project below the $autosetup_prefix prefix\n") unless project_in_scope($projectname);
  my @hdrs = defined $api_auth ? ($api_auth) : ();
  my $dir;
  eval {
    $dir = BSRPC::rpc({ 'uri' => "$source_url/source/$projectname",
    		  	   'request' => 'GET',
    		  	   'headers' => \@hdrs,
    		  	   'timeout' => 30 },
    		  	   $BSXML::dir);
  };
  return (undef, $@) unless defined $dir;
  my @names = map { $_->{'name'} } grep { ref($_) eq 'HASH' && defined $_->{'name'} && $_->{'name'} !~ /^_/ } @{$dir->{'entry'} || []};
  return (\@names, undef);
}

# Bring the packages of $projectname in line with the members of a resolved
# package_set: create or update a git backed package with a package level
# scmsync url for every member repository and delete OBS packages which point
# into the organisation on our Gitea instance but are no longer members.
# $clone_url is the git url of a repository on that Gitea instance.
sub reconcile_package_set {
  my ($projectname, $resolved, $members, $clone_url) = @_;
  return unless defined $clone_url && length $clone_url;
  my $org = $resolved->{'organisation'};

  my %desired;
  for my $member (@{ $members || [] }) {
    my $packagename = BSPreset::sanitize_package_name($member->{'name'});
    my $scmsync = BSPreset::scmsync_url_for($clone_url, $org, $member->{'name'}, $member->{'branch'});
    if (!defined $packagename || !defined $scmsync || !length $packagename) {
      print "reconcile_package_set: cannot handle member $member->{'name'}\n";
      next;
    }
    if ($desired{$packagename} && $desired{$packagename} ne $scmsync) {
      print "reconcile_package_set: package name collision for $packagename, keeping $desired{$packagename}\n";
      next;
    }
    $desired{$packagename} = $scmsync;
  }

  for my $packagename (sort keys %desired) {
    my $scmsync = $desired{$packagename};
    my ($meta, $err) = get_package_meta($projectname, $packagename);
    next unless $err || ref($meta) ne 'HASH' || !defined $meta->{'scmsync'} || $meta->{'scmsync'} ne $scmsync;
    my $xml = BSPreset::package_meta_xml($projectname, $packagename, $scmsync);
    my @hdrs = ('Content-Type: text/xml');
    push @hdrs, $api_auth if defined $api_auth;
    eval {
      BSRPC::rpc({ 'uri' => "$source_url/source/$projectname/$packagename/_meta",
      		  	   'request' => 'PUT',
      		  	   'headers' => \@hdrs,
      		  	   'timeout' => 30,
      		  	   'data' => $xml }, undef);
    };
    if ($@) {
      print "reconcile_package_set: failed to update package $projectname/$packagename: $@\n";
    } else {
      print "reconcile_package_set: set up package $projectname/$packagename\n";
    }
  }

  my ($names, $err) = get_project_packages($projectname);
  if (!defined $names) {
    print "reconcile_package_set: cannot list packages of $projectname: $err\n";
    return;
  }
  for my $packagename (@$names) {
    next if $desired{$packagename};
    my ($meta, $err) = get_package_meta($projectname, $packagename);
    next if $err || ref($meta) ne 'HASH';
    my $scmsync = $meta->{'scmsync'};
    # only delete packages which belong to the organisation on our instance
    next unless defined $scmsync && $scmsync =~ m{^(?:\w+://(?:[^@/]+@)?[^/]+|[^@/]+\@[^:/]+)[:/]\Q$org\E/};
    print "reconcile_package_set: deleting package $projectname/$packagename\n";
    delete_package($projectname, $packagename);
  }
}

# If the git repository was forked from another one, look up the upstream
# project (PREFIX:ORG:REPO:BRANCH) in OBS and return additional path entries
# for each preset repository that points into it. Same-project path entries
# of the upstream repositories are replicated pointing at the new project.
# Returns undef when the repository is not a fork or the upstream project
# does not exist.
sub parent_project_paths {
  my ($projectname, $presets, $batch) = @_;
  return undef unless ref($batch) eq 'HASH' && defined $autosetup_prefix;
  my $parent = $batch->{'repository'}{'parent'};
  return undef unless ref($parent) eq 'HASH' && $parent->{'full_name'};
  my ($p_org, $p_repo) = split('/', $parent->{'full_name'}, 2);
  return undef unless defined $p_org && defined $p_repo;
  my $branch = gitref_to_branch($batch->{'ref'});
  return undef unless defined $branch;
  # The upstream project is built from the forked-from repository. Its branch
  # may differ from the fork branch; Gitea events do not carry it, so the fork
  # branch is used unless the synthetic --parent batch specifies one.
  my $parent_branch = parent_branch_of($batch);
  $parent_branch = $branch unless defined $parent_branch;
  my $parent_project = BSPreset::branch_project_name($autosetup_prefix, $p_org, $p_repo, $parent_branch);
  my ($pmeta, $err) = get_project_meta($parent_project);
  if ($err) {
    print "parent_project_paths: upstream project $parent_project not found, building $projectname without extra paths: $err";
    return undef;
  }
  my $extrapaths = BSPreset::extrapaths_from_parent_meta($projectname, $presets, $pmeta, $parent_project);
  if ($extrapaths) {
    print "parent_project_paths: building $projectname against upstream project $parent_project\n";
  }
  return $extrapaths;
}

# Derive the owner/repo full name from a git url.
sub giturl_to_fullname {
  my ($url) = @_;
  return undef unless defined $url;
  my $path;
  if ($url =~ m{^(?:https?|ssh|git)://[^/]+/(.+)$}) {
    $path = $1;
  } elsif ($url =~ m{^[^@/]+@[^:]+:(.+)$}) {
    $path = $1;
  } else {
    return undef;
  }
  $path =~ s/\.git$//;
  $path =~ s{/+$}{};
  return $path;
}

# Resolve a "GIT_URL#BRANCH" spec into the project name, the manifest
# content taken from the given branch, the scmsync url and a synthetic event
# batch for the given (optional) parent repository the repository was forked
# from. The parent is given as "GIT_URL#BRANCH" (the branch of the
# forked-from repository, which may differ from the fork branch) or as a bare
# "ORG/REPO", in which case the fork branch is used.
sub resolve_project_spec {
  my ($spec, $parent) = @_;

  my ($giturl, $branch) = split(/#/, $spec, 2);
  die("invalid '$spec', expected GIT_URL#BRANCH_NAME\n")
    unless defined $giturl && length $giturl && defined $branch && length $branch;
  $branch = gitref_to_branch($branch);
  die("invalid '$spec', expected GIT_URL#BRANCH_NAME\n") unless defined $branch;
  my $fullname = giturl_to_fullname($giturl);
  die("cannot determine org/repo from git url '$giturl'\n") unless defined $fullname;
  die("autosetup_prefix is not configured\n") unless defined $autosetup_prefix;

  my $gitdir = "$gitea_root/gitea-repositories/" . lc($fullname) . ".git";
  my $manifest = git_show($gitdir, $branch, '_manifest');
  unless (defined $manifest) {
    my $msg = "cannot read _manifest from $giturl#$branch (git dir $gitdir";
    my $aerr = BSGit::repo_access_error($gitdir);
    if ($aerr) {
      $aerr =~ s/\n$//;
      $msg .= ": $aerr";
    }
    die("$msg)\n");
  }

  my $batch;
  if (defined $parent) {
    my ($parent_fullname, $parent_branch);
    my ($parent_spec, $pbr) = split(/#/, $parent, 2);
    if (defined $pbr) {
      $parent_fullname = giturl_to_fullname($parent_spec);
      die("invalid parent '$parent', expected GIT_URL#BRANCH or ORG/REPO\n") unless defined $parent_fullname;
      $parent_branch = gitref_to_branch($pbr);
      die("invalid parent '$parent', expected GIT_URL#BRANCH or ORG/REPO\n") unless defined $parent_branch;
    } else {
      die("invalid parent '$parent', expected GIT_URL#BRANCH or ORG/REPO\n")
        unless $parent =~ m{^[^/]+/[^/]+$};
      $parent_fullname = $parent;
      $parent_branch = $branch;
    }
    my $parent_gitdir = "$gitea_root/gitea-repositories/" . lc($parent_fullname) . ".git";
    die("parent repository not found: $parent_fullname\n") unless -d $parent_gitdir;
    my $default_branch = git_get_default_branch($parent_gitdir);
    die("cannot determine default branch of parent repository $parent_fullname\n") unless defined $default_branch;
    $batch = { 'ref' => "refs/heads/$branch",
	       'repository' => { 'full_name' => $fullname,
	       	       	       	 'clone_url' => $giturl,
	       	       	       	 'default_branch' => $default_branch,
	       	       	       	 'parent' => { 'full_name' => $parent_fullname,
	       	       	       	 	       'branch' => $parent_branch } } };
  }

  my ($org, $repo) = split('/', $fullname, 2);
  die("cannot determine org/repo from $fullname\n") unless defined $org && defined $repo;
  return (BSPreset::branch_project_name($autosetup_prefix, $org, $repo, $branch), $manifest, "$giturl#$branch", $batch);
}

# Set up a single project for a given git branch, given as "GIT_URL#BRANCH".
# An optional parent "GIT_URL#BRANCH" (or bare "ORG/REPO") marks the
# repository as forked from that repository, enabling fork handling like the
# event based setup.
sub setup_single_project {
  my ($spec, $parent) = @_;
  my ($projectname, $manifest, $scmsync, $batch) = resolve_project_spec($spec, $parent);
  setup_project($manifest, $projectname, $batch, $scmsync);
}

# Print the project meta xml for a given git branch, given as "GIT_URL#BRANCH".
# An optional parent "GIT_URL#BRANCH" (or bare "ORG/REPO") marks the
# repository as forked from that repository, enabling fork handling like the
# event based setup.
sub show_single_project {
  my ($spec, $parent) = @_;
  my ($projectname, $manifest, $scmsync, $batch) = resolve_project_spec($spec, $parent);
  my $presets = eval { BSPreset::manifest_presets($manifest) };
  die("cannot parse _manifest: $@") if $@;
  my $set = eval { BSPreset::manifest_package_set($manifest) };
  die("cannot parse _manifest: $@") if $@;
  if ($set) {
    my $clone_url = $scmsync;
    $clone_url =~ s/\#.*$//;
    my $resolved = eval { BSPreset::resolve_package_set($set, $clone_url) };
    die("cannot resolve package_set: $@") if $@;
    print BSPreset::preset_xml($projectname, $presets) if $presets && @$presets;
    my $members = BSGit::org_repo_members($gitea_root, $resolved->{'organisation'}, $resolved->{'branch'});
    $members = BSPreset::select_members($members, $resolved);
    print "package_set organisation $resolved->{'organisation'} branch $resolved->{'branch'}:\n";
    for my $member (@$members) {
      my $url = BSPreset::scmsync_url_for($clone_url, $resolved->{'organisation'}, $member->{'name'}, $member->{'branch'});
      printf("  %s -> %s\n", BSPreset::sanitize_package_name($member->{'name'}), $url);
    }
    return;
  }
  if ($presets && @$presets) {
    print project_xml($projectname, $presets, $batch, $scmsync, $manifest);
  } else {
    print "no project configured for $spec\n";
  }
}

sub repositoryevent {
  die("need event data as content\n") unless BSServer::have_content();
  my $batch_json = BSServer::read_data(10000000);
  # Gitea names the event type in a header, some payload types do not carry an
  # event field themselves
  my $hevent = BSServer::header('x-gitea-event');
  my $batch = eval { JSON::XS::decode_json($batch_json) };
  # log every incoming event before anything else may abort the handling
  print BSPreset::event_logline($batch, $hevent);
  die("no event data given\n") unless ref($batch) eq 'HASH';
  $batch->{'event'} = $hevent if defined($hevent) && !defined($batch->{'event'});
  my $kind = BSPreset::gitea_event_kind($batch);
  # events which do not concern us are acknowledged without being queued
  if (!defined($kind)) {
    return (JSON::XS::encode_json({ answer => 'ignored' }), 'Content-Type: application/json');
  }
  die("no repository given\n") unless ref($batch->{'repository'}) eq 'HASH';
  die("no clone repository given\n") unless $batch->{'repository'}->{'clone_url'};

  # write event to queue file, uniquely named and atomically visible:
  # the timestamp alone would collide on events delivered in the same second,
  # and the file must never be seen half written by process_queue
  my $timestamp = time();
  my $filename = "$timestamp-$$-" . ++$queue_serial . ".json";
  my $filepath = "$queue_dir/$filename";
  my $tmppath = "$filepath.part";
  open(my $fh, '>', $tmppath) or die("cannot write queue file $tmppath: $!\n");
  binmode($fh);
  # store the event with the normalised event type, not the raw content
  print $fh JSON::XS::encode_json($batch);
  close($fh) or die("cannot write queue file $tmppath: $!\n");
  rename($tmppath, $filepath) or die("cannot publish queue file $filepath: $!\n");

  # try to process queue
  process_queue();

  my $resp = {
    answer => 'thank you',
  };
  return (JSON::XS::encode_json($resp), 'Content-Type: application/json');
}

sub hello {
  return ("{\"message\": \"OBS Gitea Bridge\"}\n", 'Content-Type: application/json');
}

sub errorreply {
  my ($err, $code, $tag, @hdrs) = @_;
  $err = JSON::XS::encode_json({'message' => $tag});
  BSServer::reply("$err\n", "Status: $code $tag", 'Content-Type: application/json', @hdrs);
}

sub dispatch {
  my ($conf, $req) = @_;
  return BSDispatch::dispatch($conf, $req);
}

# define server
my $dispatches = [
  '/' => \&hello,
  'GET:/repositoryresults scmrepository:? scmbranch:? code:? lastbuild:? multibuild:? locallink:?' => \&repositoryresults,
  'POST:/repositoryevent' => \&repositoryevent,
];

my $conf = {
  'port' => $port,
  'proto' => $proto,
  'dispatch' => \&dispatch,
  'dispatches' => $dispatches,
  'errorreply' => \&errorreply,
  'setkeepalive' => 1,
  'maxchild' => 20,
};

# single-shot mode: setup or show a single project for a given git branch,
# then exit without starting the server. An optional --parent GIT_URL#BRANCH
# (also as --parent=GIT_URL#BRANCH) marks the repository as forked from that
# repository; the branch of the forked-from repository may differ from the fork
# branch. A bare --parent ORG/REPO is also accepted, using the fork branch.
# --setup-project, --show-project, the spec and --parent may be given in any
# order.
if (@ARGV) {
  my ($cmd, $spec, $parent);
  for (my $i = 0; $i < @ARGV; $i++) {
    my $arg = $ARGV[$i];
    if ($arg eq '--setup-project' || $arg eq '--show-project') {
      die("duplicate command $arg\n") if defined $cmd;
      $cmd = $arg;
    } elsif ($arg eq '--parent') {
      die("no parent given, missing --parent GIT_URL#BRANCH_NAME\n")
        unless defined $ARGV[$i + 1] && $ARGV[$i + 1] !~ /^--/;
      die("duplicate --parent $parent\n") if defined $parent;
      $parent = $ARGV[++$i];
    } elsif ($arg =~ /^--parent=(.+)$/) {
      die("duplicate --parent $parent\n") if defined $parent;
      $parent = $1;
    } elsif ($arg =~ /^--/) {
      die("unknown option $arg\n");
    } else {
      die("multiple specs given\n") if defined $spec;
      $spec = $arg;
    }
  }
  my $usage = "usage: $0 --setup-project|--show-project GIT_URL#BRANCH_NAME [--parent GIT_URL#BRANCH_NAME]\n";
  die("no setup/show command given\n$usage") unless defined $cmd;
  die($usage) unless defined $spec;

  if ($cmd eq '--setup-project') {
    setup_single_project($spec, $parent);
  } else {
    show_single_project($spec, $parent);
  }
  exit(0);
}

# ensure queue directory exists
mkdir($queue_dir) or die("cannot create queue directory $queue_dir: $!\n") unless -d $queue_dir;

# process any leftover events from previous run
process_queue();

BSDispatch::compile($conf);
BSServer::serveropen($conf->{'port'});
BSServer::server($conf);
