my $port = 9998;
my $proto = 'http';

my $obsurl = "https://api.opensuse.org/public";
my $header = "X-SCM-BRIDGE-COOKIE: not_configured";
my $queue_dir = "/srv/obs-gitea-bridge/queue";
my $gitea_root = "/var/lib/gitea/data";
my $autosetup_prefix;
my $api_username;
my $api_password;
eval {
  use config;
  $header = "X-SCM-BRIDGE-COOKIE: $config::shared_cookie" if $config::shared_cookie;
  $obsurl = $config::obsurl if $config::obsurl;
  $queue_dir = $config::queue_dir if $config::queue_dir;
  $gitea_root = $config::gitea_root if $config::gitea_root;
  $autosetup_prefix = $config::autosetup_prefix if $config::autosetup_prefix;
  $api_username = $config::api_username if defined $config::api_username;
  $api_password = $config::api_password if defined $config::api_password;
};

# OBS api base url without a trailing /public marker, used for the
# authenticated project meta operations below.
(my $source_url = $obsurl) =~ s{/public$}{};

# HTTP Basic Auth header for project meta create/delete operations.
my $api_auth;
if (defined $api_username && defined $api_password) {
  $api_auth = 'Authorization: Basic '.MIME::Base64::encode_base64("$api_username:$api_password", '');
}

# Fetch the download base url from the OBS api at startup and use it as
# the prefix stripped from repo urls when deriving the OBS path
# project/repository. Only needed for the analysing http server.
eval {
  my $body = BSRPC::rpc({ 'uri' => "$obsurl/configuration",
                          'request' => 'GET',
                          'headers' => [$header],
                          'timeout' => 30 }, undef);
  my ($download_url) = ($body =~ m{<download_url>\s*([^<]+?)\s*</download_url>});
  $BSPreset::gitprefix = $download_url if defined $download_url && length $download_url;
  print "using download_url $BSPreset::gitprefix\n";
} unless @ARGV;
print "failed to read download_url from $obsurl/configuration: $@\n" if $@;

sub repositoryresults {
  my ($cgi) = @_;

  my $scmrepo = $cgi->{'scmrepository'};
  my $scmbranch = $cgi->{'scmbranch'};

  my $query = {'scmrepository' => $scmrepo,
	       'scmbranch'     => $scmbranch };
  my @args = BSRPC::args($query, 'scmrepository', 'scmbranch');
  my $r = BSRPC::rpc({'uri' => "$obsurl/build/_result",
	              'request' => 'GET',
	              'headers' => [$header]},
                      $BSXML::resultlist,
                     @args);

  my $html = '<table> <tr> <th>Project</th><th>Package</th> <th>Repository</th> <th>Architecture</th> <th>Result</th> </tr>';
  my $lastproject = '';
  my $lastpackage = '';
  my $lastrepo = '';
  my $count = 0;
  for my $result (@{$r->{'result'} || []}) {
    my $project = $result->{'project'};
    my $package = $result->{'status'}[0]->{'package'} || undef;
    my $repo    = $result->{'repository'};
    my $arch    = $result->{'arch'};
    my $code    = $result->{'status'}[0]->{'code'} || 'unknown';

    $project = '' if $project eq $lastproject;
    $package = '' if $package eq $lastpackage;
    $repo = ''    if $repo eq $lastrepo;
    $count = $count + 1;

    my $bgcolor = "#fff";
    $bgcolor = "#bbb" if $code eq 'scheduled' || $code eq 'building' ||  $code eq 'finished' || $code eq 'blocked';
    my $color = "#FFF";
    $color = "#6EB927" if $code eq 'succeeded';
    $color = "#666" if $code eq 'signing';
    $color = "#222" if $code eq 'finished';
    $color = "#c00" if $code eq 'unresolvable';
    $color = "#e00" if $code eq 'broken';
    $color = "#f00" if $code eq 'failed';
    $color = "#fff" if $code eq 'blocked';

    $html .= "<tr><td>$project</td><td>$package</td> <td>$repo</td> <td>$arch</td> <td bgcolor=\"$bgcolor\"><font color=\"$color\">$code</font></td> </tr>\n";

    $lastproject = $project unless $project eq '' ;
    $lastpackage = $package unless $package eq '' ;
    $lastrepo    = $repo    unless $repo eq '';
    last if $count > 10;
  };
  $html .= '</table>';
  $html .= '<p>.... uncollapsing not implemeted...</p>' if $count > 10;
  return $html;
}

sub gitref_to_branch {
  my ($ref) = @_;
  return undef unless defined $ref;
  $ref =~ s/^refs\/heads\///;
  $ref =~ s/^refs\/tags\///;
  $ref =~ s/^refs\///;
  return $ref;
}

# Read the given file from the given branch of a git repository. Returns
# undef when the repository or the file does not exist (git's error output
# is suppressed).
sub git_show {
  my ($gitdir, $branch, $file) = @_;
  my $pid = open(my $fh, '-|');
  if (!defined $pid) {
    die("cannot fork: $!\n");
  }
  if ($pid == 0) {
    open(STDERR, '>', '/dev/null');
    exec('git', "--git-dir=$gitdir", 'show', "$branch:$file");
    exit 255;
  }
  my $data = do { local $/; <$fh> };
  close($fh);
  return undef if ($? >> 8) != 0;
  return $data;
}

# Run a git command and return its standard output as an arrayref of lines,
# or undef on failure (git's error output is suppressed).
sub git_capture {
  my (@args) = @_;
  my $pid = open(my $fh, '-|');
  if (!defined $pid) {
    die("cannot fork: $!\n");
  }
  if ($pid == 0) {
    open(STDERR, '>', '/dev/null');
    exec('git', @args);
    exit 255;
  }
  my @lines = <$fh>;
  close($fh);
  return undef if ($? >> 8) != 0;
  chomp @lines;
  return \@lines;
}

# Return the short name of the default branch of the given git repository,
# or undef when it cannot be determined.
sub git_get_default_branch {
  my ($gitdir) = @_;
  return undef unless defined $gitdir;
  my $out = git_capture('--git-dir=' . $gitdir, 'symbolic-ref', '--short', 'HEAD');
  return undef unless $out && defined $out->[0] && length $out->[0];
  return $out->[0];
}

# List the package source entries at the given tree level of the given git
# repository, as an arrayref of names (empty arrayref when the level has no
# package sources), or undef on failure. Plain files are not package sources.
# Both directories and submodules are package sources: a submodule entry is a
# single commit reference inside the tree.
sub git_lstree_sources {
  my ($gitdir, $tree) = @_;
  return undef unless defined $gitdir && defined $tree;
  my $out = git_capture('--git-dir=' . $gitdir, 'ls-tree', "$tree");
  my @sources;
  if ($out) {
    for my $line (@$out) {
      next unless $line =~ m{^\S+\s+(?:tree|commit)\s+\S+\t(.+)$};
      push @sources, $1;
    }
  }
  return \@sources;
}

# In the fork case, determine the set of package source directories whose
# latest content differs from the repository this git repo was forked from.
# Package source directories are derived from the _manifest subdirectories
# array (or the top level when absent). Returns a sorted arrayref of changed
# package source directories, or undef when the batch is not a fork or the
# manifest cannot be parsed.
sub fork_changed_package_sources {
  my ($manifest, $batch) = @_;
  my $repository = ref($batch) eq 'HASH' ? $batch->{'repository'} : undef;
  my $parent = ref($repository) eq 'HASH' ? $repository->{'parent'} : undef;
  return undef unless ref($parent) eq 'HASH' && $parent->{'full_name'} && $repository->{'full_name'};
  my $branch = gitref_to_branch($batch->{'ref'});
  return undef unless defined $branch;
  # The branch of the forked-from repository may differ from the fork branch,
  # e.g. when the fork lives on a differently named branch. Gitea events do not
  # carry it, so the fork branch is used unless the synthetic --parent batch
  # specifies one.
  my $parent_branch = parent_branch_of($batch);
  $parent_branch = $branch unless defined $parent_branch;
  my $gitdir = "$gitea_root/gitea-repositories/" . lc($repository->{'full_name'}) . ".git";
  my $parent_gitdir = "$gitea_root/gitea-repositories/" . lc($parent->{'full_name'}) . ".git";
  my $subdirectories = eval { BSPreset::manifest_subdirectories($manifest) };
  return undef if $@;
  my %entries;
  if (ref($subdirectories) eq 'ARRAY' && @$subdirectories) {
    for my $sub (@$subdirectories) {
      $entries{$sub} = git_lstree_sources($gitdir, "$branch:$sub");
    }
  } else {
    $entries{''} = git_lstree_sources($gitdir, $branch);
  }
  my $dirs = BSPreset::package_source_dirs($subdirectories, %entries);
  my %hashes;
  my %parent_hashes;
  for my $dir (@$dirs) {
    my $out = git_capture('--git-dir=' . $gitdir, 'rev-parse', "$branch:$dir");
    $hashes{$dir} = $out->[0] if $out && defined $out->[0];
    my $pout = git_capture('--git-dir=' . $parent_gitdir, 'rev-parse', "$parent_branch:$dir");
    $parent_hashes{$dir} = $pout->[0] if $pout && defined $pout->[0];
  }
  return [ sort @{ BSPreset::changed_package_sources($dirs, \%hashes, \%parent_hashes) } ];
}

# Return the branch of the forked-from repository from a fork batch, or undef
# when the batch does not specify one. Gitea webhook batches carry no parent
# branch, only the synthetic --parent batch constructed for the single-shot
# commands does.
sub parent_branch_of {
  my ($batch) = @_;
  my $repository = ref($batch) eq 'HASH' ? $batch->{'repository'} : undef;
  my $parent = ref($repository) eq 'HASH' ? $repository->{'parent'} : undef;
  return undef unless ref($parent) eq 'HASH';
  my $branch = $parent->{'branch'};
  return undef unless defined $branch && length $branch;
  return gitref_to_branch($branch);
}

sub process_queue {
  return unless -d $queue_dir;

  opendir(DIR_HANDLE, $queue_dir) or return;
  my @files = sort grep { /^\d+\.json$/ } readdir(DIR_HANDLE);
  closedir(DIR_HANDLE);
  return unless @files;

  for my $file (@files) {
    my $filepath = "$queue_dir/$file";
    my $content = do { local $/; open(my $fh, '<', $filepath) or next; binmode($fh); <$fh> };
    my $batch = JSON::XS::decode_json($content);
    next unless $batch && $batch->{'ref'} && $batch->{'repository'}->{'clone_url'};

    my $branch = gitref_to_branch($batch->{'ref'});

    my $fullname = $batch->{'repository'}->{'full_name'};
    if ($fullname && defined $autosetup_prefix) {
      my $gitdir = "$gitea_root/gitea-repositories/" . lc($fullname) . ".git";
      my $manifest = git_show($gitdir, $branch, '_manifest');
      if (defined $manifest) {
        my ($org, $repo) = split('/', $fullname, 2);
        if (!defined $org || !defined $repo) {
          print "setup_project: cannot determine org/repo from $fullname\n";
        } else {
          $org =~ s/:/_/g;
          $repo =~ s/:/_/g;
          my $scmsync = "$batch->{'repository'}->{'clone_url'}#$branch";
          eval {
            setup_project($manifest, "$autosetup_prefix:$org:$repo:$branch", $batch, $scmsync);
          };
          print "setup_project: failed: $@" if $@;
        }
      }
    }

    my $cgi = { 'cmd'           => 'triggerscmsync',
		'scmrepository' => $batch->{'repository'}->{'clone_url'},
		'scmbranch'     => $branch };
    $cgi->{'isdefaultbranch'} = 1 if $batch->{'repository'}->{'default_branch'} eq $branch;
    my @args = BSRPC::args($cgi, 'cmd', 'scmrepository', 'scmbranch', 'isdefaultbranch');

    eval {
      my $h = BSRPC::rpc({ 'uri' => "$obsurl/source",
      		  	   'request' => 'POST',
      		  	   'headers' => [$header],
      		  	   'timeout' => 30 }, undef, @args);
    };
    if ($@) {
      print "Queue: failed to process $file: $@\n";
      last;
    } else {
      unlink($filepath) or print "Queue: failed to delete $filepath: $!\n";
      print "Processed: $batch->{'repository'}->{'clone_url'}#$branch from $file\n";
    }
  }
}

sub setup_project {
  my ($manifest, $projectname, $batch, $scmsync) = @_;
  my $presets = eval { BSPreset::manifest_presets($manifest) };
  if ($@) {
    print "setup_project: $@";
    return;
  }
  if ($presets && @$presets) {
    create_or_update_project($projectname, $presets, $batch, $scmsync, $manifest);
  } else {
    delete_project($projectname);
  }
}

sub delete_project {
  my ($projectname) = @_;
  print "delete_project: deleting project $projectname\n";
  my @hdrs = defined $api_auth ? ($api_auth) : ();
  eval {
    BSRPC::rpc({ 'uri' => "$source_url/source/$projectname/_meta",
    		  	   'request' => 'DELETE',
    		  	   'headers' => \@hdrs,
    		  	   'timeout' => 30 }, undef);
  };
  print "delete_project: failed to delete $projectname: $@\n" if $@;
}

# Build the project meta xml for $projectname. In the fork case, add upstream
# path entries for each preset repository and restrict the build to the package
# sources that actually changed against the forked-from repository, by adding
# an onlybuild CGI parameter per changed package to the scmsync url.
# Dies when the project xml cannot be built.
sub project_xml {
  my ($projectname, $presets, $batch, $scmsync, $manifest) = @_;

  my $extrapaths = parent_project_paths($projectname, $presets, $batch);
  my $changed = fork_changed_package_sources($manifest, $batch);
  if ($changed && @$changed) {
    $scmsync = BSPreset::scmsync_with_onlybuild($scmsync, $changed);
    print "project_xml: building $projectname only for changed packages: @$changed\n";
  }
  my $xml = eval { BSPreset::preset_xml($projectname, $presets, $extrapaths, $scmsync) };
  die("cannot build project xml for $projectname: $@\n") if $@;
  return $xml;
}

sub create_or_update_project {
  my ($projectname, $presets, $batch, $scmsync, $manifest) = @_;

  my $xml = eval { project_xml($projectname, $presets, $batch, $scmsync, $manifest) };
  if ($@) {
    print "create_or_update_project: $@";
    return;
  }
  print "create_or_update_project: project xml for $projectname:\n$xml";

  my @hdrs = ('Content-Type: text/xml');
  push @hdrs, $api_auth if defined $api_auth;
  eval {
    BSRPC::rpc({ 'uri' => "$source_url/source/$projectname/_meta",
    		  	   'request' => 'PUT',
    		  	   'headers' => \@hdrs,
    		  	   'timeout' => 30,
    		  	   'data' => $xml }, undef);
  };
  print "create_or_update_project: failed to update $projectname: $@\n" if $@;
}

# Read the project meta of $projectname from the OBS api.
sub get_project_meta {
  my ($projectname) = @_;
  my @hdrs = defined $api_auth ? ($api_auth) : ();
  my $meta;
  eval {
    $meta = BSRPC::rpc({ 'uri' => "$source_url/source/$projectname/_meta",
    		  	   'request' => 'GET',
    		  	   'headers' => \@hdrs,
    		  	   'timeout' => 30 },
    		  	   $BSXML::proj);
  };
  return ($meta, $@);
}

# If the git repository was forked from another one, look up the upstream
# project (PREFIX:ORG:REPO:BRANCH) in OBS and return additional path entries
# for each preset repository that points into it. Same-project path entries
# of the upstream repositories are replicated pointing at the new project.
# Returns undef when the repository is not a fork or the upstream project
# does not exist.
sub parent_project_paths {
  my ($projectname, $presets, $batch) = @_;
  return undef unless ref($batch) eq 'HASH' && defined $autosetup_prefix;
  my $parent = $batch->{'repository'}{'parent'};
  return undef unless ref($parent) eq 'HASH' && $parent->{'full_name'};
  my ($p_org, $p_repo) = split('/', $parent->{'full_name'}, 2);
  return undef unless defined $p_org && defined $p_repo;
  my $branch = gitref_to_branch($batch->{'ref'});
  return undef unless defined $branch;
  # The upstream project is built from the forked-from repository. Its branch
  # may differ from the fork branch; Gitea events do not carry it, so the fork
  # branch is used unless the synthetic --parent batch specifies one.
  my $parent_branch = parent_branch_of($batch);
  $parent_branch = $branch unless defined $parent_branch;
  $p_org =~ s/:/_/g;
  $p_repo =~ s/:/_/g;
  my $parent_project = "$autosetup_prefix:$p_org:$p_repo:$parent_branch";
  my ($pmeta, $err) = get_project_meta($parent_project);
  if ($err) {
    print "parent_project_paths: upstream project $parent_project not found, building $projectname without extra paths: $err";
    return undef;
  }
  my $extrapaths = BSPreset::extrapaths_from_parent_meta($projectname, $presets, $pmeta, $parent_project);
  if ($extrapaths) {
    print "parent_project_paths: building $projectname against upstream project $parent_project\n";
  }
  return $extrapaths;
}

# Derive the owner/repo full name from a git url.
sub giturl_to_fullname {
  my ($url) = @_;
  return undef unless defined $url;
  my $path;
  if ($url =~ m{^(?:https?|ssh|git)://[^/]+/(.+)$}) {
    $path = $1;
  } elsif ($url =~ m{^[^@/]+@[^:]+:(.+)$}) {
    $path = $1;
  } else {
    return undef;
  }
  $path =~ s/\.git$//;
  $path =~ s{/+$}{};
  return $path;
}

# Resolve a "GIT_URL#BRANCH" spec into the project name, the manifest
# content taken from the given branch, the scmsync url and a synthetic event
# batch for the given (optional) parent repository the repository was forked
# from. The parent is given as "GIT_URL#BRANCH" (the branch of the
# forked-from repository, which may differ from the fork branch) or as a bare
# "ORG/REPO", in which case the fork branch is used.
sub resolve_project_spec {
  my ($spec, $parent) = @_;

  my ($giturl, $branch) = split(/#/, $spec, 2);
  die("invalid '$spec', expected GIT_URL#BRANCH_NAME\n")
    unless defined $giturl && length $giturl && defined $branch && length $branch;
  $branch = gitref_to_branch($branch);
  die("invalid '$spec', expected GIT_URL#BRANCH_NAME\n") unless defined $branch;
  my $fullname = giturl_to_fullname($giturl);
  die("cannot determine org/repo from git url '$giturl'\n") unless defined $fullname;
  die("autosetup_prefix is not configured\n") unless defined $autosetup_prefix;

  my $gitdir = "$gitea_root/gitea-repositories/" . lc($fullname) . ".git";
  my $manifest = git_show($gitdir, $branch, '_manifest');
  die("cannot read _manifest from $giturl#$branch\n") unless defined $manifest;

  my $batch;
  if (defined $parent) {
    my ($parent_fullname, $parent_branch);
    my ($parent_spec, $pbr) = split(/#/, $parent, 2);
    if (defined $pbr) {
      $parent_fullname = giturl_to_fullname($parent_spec);
      die("invalid parent '$parent', expected GIT_URL#BRANCH or ORG/REPO\n") unless defined $parent_fullname;
      $parent_branch = gitref_to_branch($pbr);
      die("invalid parent '$parent', expected GIT_URL#BRANCH or ORG/REPO\n") unless defined $parent_branch;
    } else {
      die("invalid parent '$parent', expected GIT_URL#BRANCH or ORG/REPO\n")
        unless $parent =~ m{^[^/]+/[^/]+$};
      $parent_fullname = $parent;
      $parent_branch = $branch;
    }
    my $parent_gitdir = "$gitea_root/gitea-repositories/" . lc($parent_fullname) . ".git";
    die("parent repository not found: $parent_fullname\n") unless -d $parent_gitdir;
    my $default_branch = git_get_default_branch($parent_gitdir);
    die("cannot determine default branch of parent repository $parent_fullname\n") unless defined $default_branch;
    $batch = { 'ref' => "refs/heads/$branch",
	       'repository' => { 'full_name' => $fullname,
	       	       	       	 'clone_url' => $giturl,
	       	       	       	 'default_branch' => $default_branch,
	       	       	       	 'parent' => { 'full_name' => $parent_fullname,
	       	       	       	 	       'branch' => $parent_branch } } };
  }

  my ($org, $repo) = split('/', $fullname, 2);
  die("cannot determine org/repo from $fullname\n") unless defined $org && defined $repo;
  $org =~ s/:/_/g;
  $repo =~ s/:/_/g;
  return ("$autosetup_prefix:$org:$repo:$branch", $manifest, "$giturl#$branch", $batch);
}

# Set up a single project for a given git branch, given as "GIT_URL#BRANCH".
# An optional parent "GIT_URL#BRANCH" (or bare "ORG/REPO") marks the
# repository as forked from that repository, enabling fork handling like the
# event based setup.
sub setup_single_project {
  my ($spec, $parent) = @_;
  my ($projectname, $manifest, $scmsync, $batch) = resolve_project_spec($spec, $parent);
  setup_project($manifest, $projectname, $batch, $scmsync);
}

# Print the project meta xml for a given git branch, given as "GIT_URL#BRANCH".
# An optional parent "GIT_URL#BRANCH" (or bare "ORG/REPO") marks the
# repository as forked from that repository, enabling fork handling like the
# event based setup.
sub show_single_project {
  my ($spec, $parent) = @_;
  my ($projectname, $manifest, $scmsync, $batch) = resolve_project_spec($spec, $parent);
  my $presets = eval { BSPreset::manifest_presets($manifest) };
  die("cannot parse _manifest: $@") if $@;
  if ($presets && @$presets) {
    print project_xml($projectname, $presets, $batch, $scmsync, $manifest);
  } else {
    print "no project configured for $spec\n";
  }
}

sub repositoryevent {
  die("need event data as content\n") unless BSServer::have_content();
  my $batch_json = BSServer::read_data(10000000);
  my $batch = JSON::XS::decode_json($batch_json);

  die("no ref given\n") unless $batch->{'ref'};
  die("no repository given\n") unless $batch->{'repository'};
  die("no clone repository given\n") unless $batch->{'repository'}->{'clone_url'};

  # write event to queue file
  my $timestamp = time();
  my $filepath = "$queue_dir/$timestamp.json";
  open(my $fh, '>', $filepath) or die("cannot write queue file $filepath: $!\n");
  binmode($fh);
  print $fh $batch_json;
  close($fh);

  # try to process queue
  process_queue();

  my $resp = {
    answer => 'thank you',
  };
  #  print Dumper(JSON::XS::encode_json($resp));
  # print "Received: $filepath\n";
  return (JSON::XS::encode_json($resp), 'Content-Type: application/json');
}

sub hello {
  return ("{\"message\": \"OBS Gitea Bridge\"}\n", 'Content-Type: application/json');
}

sub errorreply {
  my ($err, $code, $tag, @hdrs) = @_;
  $err = JSON::XS::encode_json({'message' => $tag});
  BSServer::reply("$err\n", "Status: $code $tag", 'Content-Type: application/json', @hdrs);
}

sub dispatch {
  my ($conf, $req) = @_;
  return BSDispatch::dispatch($conf, $req);
}

# define server
my $dispatches = [
  '/' => \&hello,
  'GET:/repositoryresults scmrepository:? scmbranch:? code:? lastbuild:? multibuild:? locallink:?' => \&repositoryresults,
  'POST:/repositoryevent' => \&repositoryevent,
];

my $conf = {
  'port' => $port,
  'proto' => $proto,
  'dispatch' => \&dispatch,
  'dispatches' => $dispatches,
  'errorreply' => \&errorreply,
  'setkeepalive' => 1,
  'maxchild' => 20,
};

# single-shot mode: setup or show a single project for a given git branch,
# then exit without starting the server. An optional --parent GIT_URL#BRANCH
# (also as --parent=GIT_URL#BRANCH) marks the repository as forked from that
# repository; the branch of the forked-from repository may differ from the fork
# branch. A bare --parent ORG/REPO is also accepted, using the fork branch.
# --setup-project, --show-project, the spec and --parent may be given in any
# order.
if (@ARGV) {
  my ($cmd, $spec, $parent);
  for (my $i = 0; $i < @ARGV; $i++) {
    my $arg = $ARGV[$i];
    if ($arg eq '--setup-project' || $arg eq '--show-project') {
      die("duplicate command $arg\n") if defined $cmd;
      $cmd = $arg;
    } elsif ($arg eq '--parent') {
      die("no parent given, missing --parent GIT_URL#BRANCH_NAME\n")
        unless defined $ARGV[$i + 1] && $ARGV[$i + 1] !~ /^--/;
      die("duplicate --parent $parent\n") if defined $parent;
      $parent = $ARGV[++$i];
    } elsif ($arg =~ /^--parent=(.+)$/) {
      die("duplicate --parent $parent\n") if defined $parent;
      $parent = $1;
    } elsif ($arg =~ /^--/) {
      die("unknown option $arg\n");
    } else {
      die("multiple specs given\n") if defined $spec;
      $spec = $arg;
    }
  }
  my $usage = "usage: $0 --setup-project|--show-project GIT_URL#BRANCH_NAME [--parent GIT_URL#BRANCH_NAME]\n";
  die("no setup/show command given\n$usage") unless defined $cmd;
  die($usage) unless defined $spec;

  if ($cmd eq '--setup-project') {
    setup_single_project($spec, $parent);
  } else {
    show_single_project($spec, $parent);
  }
  exit(0);
}

# ensure queue directory exists
mkdir($queue_dir) or die("cannot create queue directory $queue_dir: $!\n") unless -d $queue_dir;

# process any leftover events from previous run
process_queue();

BSDispatch::compile($conf);
BSServer::serveropen($conf->{'port'});
BSServer::server($conf);
